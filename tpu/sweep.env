# v5e-1 sweep parameters: the single source of truth for launch.sh, which passes the VM-side values on as
# queued-resource metadata. A real environment variable wins over anything set here.
# Values follow ~/gemma4-dev/tpu-vllm-v5e1-2b/tpu.env and ~/gemma4-dev/jev-tpu-v5e1/README.md.

GOOGLE_CLOUD_PROJECT=aisprint-491218
# Flex-start v5litepod-1 is accepted only in us-west4-a (~/gemma4-dev/CLAUDE.md, "Cloud gotchas").
GOOGLE_CLOUD_ZONE=us-west4-a
ACCELERATOR_TYPE=v5litepod-1
RUNTIME_VERSION=v2-alpha-tpuv5-lite
MAX_RUN_DURATION=4h
VALID_UNTIL_DURATION=2h

# Code bundles go under inputs/, each run's results and logs under <run>/.
GCS_ROOT=gs://aisprint-491218-bucket/model-sweep

# The image every arm serves. Pinned by digest, so every arm in a comparison runs the same build: vLLM
# 0.29.1rc1.dev468+g0b7f11a1e, the digest the ~/gemma4-dev v5e-1 runs of 2026-09-29 to 10-02 used.
IMAGE=vllm/vllm-tpu@sha256:19a1a0526476f902eb83e1057f3d8938f35b457dd7716a30e9ab4f7bee90d507
